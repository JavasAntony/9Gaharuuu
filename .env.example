# Project URL from the Supabase dashboard (Project Settings -> API).
# Exposed to the browser on purpose: it is not a secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable key (Project Settings -> API Keys -> Publishable key).
# Safe to ship to the browser: RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# The secret key (Project Settings -> API Keys -> Secret key).
# ONLY used by scripts/seed-users.mjs and scripts/test-rls.mjs.
# Never prefix this with NEXT_PUBLIC_, never import it into app code,
# and never add it to the Vercel project for v1.
SUPABASE_SECRET_KEY=sb_secret_your_key
